# Copy to .env.local (never commit .env.local).
# Local values: run `npx supabase start`, then `npx supabase status`.

# Supabase (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key: SERVER ONLY, bypasses RLS.
# Used only by src/lib/supabase/admin.ts for manager-verified invites.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Responses API, used for AI insights only). SERVER ONLY.
# OPENAI_MODEL: any OpenAI model that supports the Responses API with
# structured outputs (json_schema), e.g. a current GPT model id from your
# OpenAI dashboard. Nothing in the code hardcodes a model; without both values
# "Generate AI Insights" shows "AI is not configured".
OPENAI_API_KEY=
OPENAI_MODEL=

# Dev/test only: AI_FAKE=1 swaps OpenAI for a deterministic fake (no network,
# model recorded as "fake-ai"). Used by integration tests and Playwright e2e.
# Ignored in production builds (NODE_ENV=production) and on Vercel.
# AI_FAKE=1

# Public base URL of the app (used for auth redirect links, e.g. invites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
