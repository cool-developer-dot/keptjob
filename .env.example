# Copy to .env.local (never commit .env.local).
# Local values: run `npx supabase start`, then `npx supabase status`.

# Supabase (public, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key: SERVER ONLY, bypasses RLS.
# Used only by src/lib/supabase/admin.ts for manager-verified invites.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (Responses API, used for AI insights only)
OPENAI_API_KEY=
OPENAI_MODEL=

# Public base URL of the app (used for auth redirect links, e.g. invites)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
